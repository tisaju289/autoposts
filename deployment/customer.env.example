# Customer-owned project ONLY. Browser-safe values, injected at build time:
VITE_CUSTOM_BACKEND_URL=
VITE_CUSTOM_BACKEND_PUBLISHABLE_KEY=
# Server environment, same customer project (never use VITE_ for secrets):
CUSTOM_BACKEND_URL=
CUSTOM_BACKEND_PUBLISHABLE_KEY=
CUSTOM_BACKEND_SECRET_KEY=
# Server-only Gemini key for this customer:
GEMINI_API_KEY=
# Server-only Google OAuth credentials; optional unless Drive/Sheets used:
CUSTOM_GOOGLE_CLIENT_ID=
CUSTOM_GOOGLE_CLIENT_SECRET=
CUSTOM_GOOGLE_REFRESH_TOKEN=
